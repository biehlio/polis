# Polis Minimal Configuration for Coolify Deployment
# This is a minimal .env file with ONLY the required variables to run Polis
# Copy this to .env and fill in the values marked with [REQUIRED]

###### DATABASE ######
POSTGRES_DB=polis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=[REQUIRED]_change_me_to_a_strong_password
POSTGRES_HOST=postgres:5432
DATABASE_URL=postgres://postgres:[REQUIRED]_change_me_to_a_strong_password@postgres:5432/polis

###### DOCKER SETTINGS ######
TAG=prod
COMPOSE_PROJECT_NAME=polis-prod

###### PORTS ######
API_SERVER_PORT=5000
HTTP_PORT=80
HTTPS_PORT=443
STATIC_FILES_PORT=8080

###### CORE CONFIGURATION ######
DEV_MODE=false
NODE_ENV=production
MATH_ENV=prod

###### DOMAIN/HOSTNAME ######
API_PROD_HOSTNAME=[REQUIRED]_your_domain_name_here
DOMAIN_OVERRIDE=[REQUIRED]_your_domain_name_here
STATIC_FILES_HOST=file-server

###### AUTHENTICATION (OIDC) ######
AUTH_ISSUER=[REQUIRED]_your_oidc_issuer_url
AUTH_CLIENT_ID=[REQUIRED]_your_client_id
AUTH_AUDIENCE=[REQUIRED]_your_audience
JWKS_URI=[REQUIRED]_your_jwks_uri

###### JWT KEYS (for participant authentication) ######
# Generate with: openssl genpkey -algorithm RSA -out jwt-private.pem -pkeyopt rsa_keygen_bits:4096
# Then base64 encode the keys and paste them here, or use file paths
JWT_PRIVATE_KEY=[REQUIRED]_base64_encoded_private_key_or_file_path
JWT_PUBLIC_KEY=[REQUIRED]_base64_encoded_public_key_or_file_path

###### EMAIL CONFIGURATION ######
POLIS_FROM_ADDRESS="Polis <noreply@yourdomain.com>"
ADMIN_EMAILS=[]

###### OPTIONAL: Third-Party API Keys ######
# Only set these if you want to use the corresponding features
# AI Model providers (choose at least one if using AI features):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Optional: Comment moderation
# AKISMET_ANTISPAM_API_KEY=

# Optional: Analytics
# GA_TRACKING_ID=

###### ADMIN CONFIGURATION ######
ADMIN_UIDS=[]

###### LOGGING ######
SERVER_LOG_LEVEL=warn
MATH_LOG_LEVEL=warn

###### SECURITY ######
DATABASE_SSL=false

###### OPTIONAL: Additional Configuration ######
# Uncomment and modify if needed:
# DOMAIN_WHITELIST_ITEM_01=additional-domain.com
# EMBED_SERVICE_HOSTNAME=${API_PROD_HOSTNAME}
# READ_ONLY_DATABASE_URL=
